 244→                Alliance_box box = DataAtlasManager.Instance.GetDataWithTypeById<Alliance_box>(giftLvl.ToString());\n   245→                var cmd = CommandBase.create(\"3rd.facebook.getbindreward\");\n   246→                cmd.setSuccessCallback(GetRewardDataCallBack);\n   247→                cmd.putParam(\"rewardId\", box.reward);\n   248→                cmd.sendAndRelease();\n   249→            }\n   250→        }\n   251→\n   252→        private void GetRewardDataCallBack(NetResult obj)\n   253→        {\n   254→            List<ItemInfo> itemList = new List<ItemInfo>();\n   255→            var dict = obj.Data as CCDictionary;\n   256→            if (dict != null)\n   257→            {\n   258→                var rewards = dict[\"rewards\"] as CCArray;\n   259→                if (rewards != null)\n   260→                {\n   261→                    CCCommonUtils.ParseServerReward(rewards, itemList);\n   262→                    if (_presentView == null)\n   263→                    {\n   264→                        _presentView = PresentListView.create(itemList);\n   265→                        _presentView.setPosition(_previewLocationPos.xy);\n   266→                        _mainView.AddChild(_presentView);\n   267→                    }\n   268→                    else\n   269→                    {\n   270→                        _presentView.setVisible(true);\n   271→                        _presentView.setData(itemList);\n   272→                    }\n   273→                }\n   274→            }\n   275→        }\n   276→\n   277→        private void OnTouchEnded(EventContext context)\n   278→        {\n   279→            if (_presentView != null && _presentView.visible\n   280→                && !Global.isTouchInside(_presentView, context))\n   281→            {\n   282→                _presentView.setVisible(false);\n   283→            }\n   284→        }\n   285→\n   286→        private void OnChangeTab(EventContext context)\n   287→        {\n   288→            _currentTab = _giftTab.selectedIndex;\n   289→            RefreshView(null);\n   290→        }\n   291→\n   292→        private void OnClickBuyButton()\n   293→        {\n   294→            PopupViewController.getInstance().removeAllPopupView();\n   295→            ActivityView.Create(\"DailyReward\");\n   296→        }\n   297→        #endregion\n   298→\n   299→        #region 私有方法 - 数据刷新\n   300→        private void RefreshView(object p)\n   301→        {\n   302→            if (_giftController == null || !_giftController.getIsDataBack())\n   303→            {\n   304→                if (_boxRedNode != null) _boxRedNode.OnRedTipUpdate(0, RedTipStrategy.Number);\n   305→                if (_normalRedNode != null) _normalRedNode.SetData(\"\");\n   306→                if (_specialRedNode != null) _specialRedNode.SetData(\"\");\n   307→                return;\n   308→            }\n   309→\n   310→            _normalRedNode.SetData(\"Alliance_generalGift\");\n   311→            _specialRedNode.SetData(\"Alliance_specialGift\");\n   312→\n   313→            if (_firstInView)\n   314→            {\n   315→                _firstInView = false;\n   316→                CCCommonUtils.CheckAllianceGiftNums(out var nNum, out var sNum);\n   317→                _giftTab.SetSelectedIndex(nNum < 1 && sNum > 0 ? 1 : 0);\n   318→                _currentTab = _giftTab.selectedIndex;\n   319→            }\n   320→\n   321→            UpdateGiftLimitTexts();\n   322→            UpdateBoxInfo();\n   323→            UpdateGiftList();\n   324→            UpdateBars();\n   325→\n   326→            _anonymSetBtn.selected = _giftController.getUnnamedStatus() == 1;\n   327→        }\n   328→\n   329→        private void UpdateGiftLimitTexts()\n   330→        {\n   331→            int recvLimit = _giftController.m_recGiftLimit;\n   332→            int recvCount = recvLimit - _giftController.m_recGiftCount;\n   333→            _recvGiftCountText.text = Global._lang_2(\"ZH400042887\", recvCount.ToString(), recvLimit.ToString());\n   334→\n   335→            int sendLimit = _giftController.m_sendGiftLimit;\n   336→            int sendCount = sendLimit - _giftController.m_sendGiftCount;\n   337→            _sendGiftCountText.text = Global._lang_2(\"ZH400042888\", sendCount.ToString(), sendLimit.ToString());\n   338→        }\n   339→\n   340→        private void UpdateBoxInfo()\n   341→        {\n   342→            _boxes.Clear();\n   343→            _boxes.AddRange(_giftController.m_fbAllianceBoxInfo.Values);\n   344→            _boxes.Sort((l, r) => l.createTime.CompareTo(r.createTime));\n   345→\n   346→            int boxLevel = _boxes.Count > 0 ? _boxes[0].level : _giftController.getOnLevel();\n   347→            _boxNameText.setString(Global._lang_1(\"2000001715\", boxLevel));\n   348→            _boxRedNode.OnRedTipUpdate(_boxes.Count, RedTipStrategy.Number);\n   349→        }\n   350→\n   351→        private void UpdateGiftList()\n   352→        {\n   353→            _data.Clear();\n   354→            foreach (var gift in _giftController.m_fbAllianceGiftInfo.Values)\n   355→            {\n   356→                if (gift.type == _currentTab)\n   357→                {\n   358→                    _data.Add(gift);\n   359→                }\n   360→            }\n   361→            _data.Sort((g1, g2) => g1.createTime.CompareTo(g2.createTime));\n   362→            _list.numItems = _data.Count;\n   363→            _controller.selectedIndex = _data.Count > 0 ? 0 : 1;\n   364→        }\n   365→\n   366→        private void UpdateBars()\n   367→        {\n   368→            RefreshBar1();\n   369→            RefreshBar2();\n   370→        }\n   371→\n   372→        private void RefreshBar1()\n   373→        {\n   374→            _giftLevel.text = Global._lang_1(\"77100055\", _giftController.getOnLevel());\n   375→            double max = _giftController.getOnMaxExp();\n   376→            double value = _giftController.getOnCurrExp();\n   377→            _giftLevelProgress.fillAmount = (float)(value / max);\n   378→        }\n   379→\n   380→        private void RefreshBar2()\n   381→        {\n   382→            int curExp = _giftController.getBoxExp();\n   383→            int maxExp = _giftController.getBoxMaxExp();\n   384→            _boxProgress.setScaleX(curExp, maxExp);\n   385→        }\n   386→        #endregion\n   387→\n   388→        #region 公共方法 - 列表渲染\n   389→        /// <summary>\n   390→        /// 列表项渲染器\n   391→        /// </summary>\n   392→        public void ItemRenderer(int idx, GObject item)\n   393→        {\n   394→            if (idx >= _data.Count)\n   395→                return;\n   396→\n   397→            FBAllianceGiftCell cell = item as FBAllianceGiftCell;\n   398→            if (cell != null)\n   399→                cell.SetData(idx, _data[idx]);\n   400→        }\n   401→\n   402→        /// <summary>\n   403→        /// 重置视图状态\n   404→        /// </summary>\n   405→        public void Reset()\n   406→        {\n   407→            _list.numItems = 0;\n   408→        }\n   409→        #endregion\n   410→    }\n   411→}\n   412→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"uuid":"4e39dad7-ca06-40e7-b71d-324750d6c872","timestamp":"2026-03-25T06:26:58.903Z","toolUseResult":{"type":"text","file":{"filePath":"e:\\WorkSpace\\RedAlert_SuperFormation\\Assets\\DevCodeFM\\IF\\DayZClasses\\view\\popup\\alliance\\AllianceGiftView\\FBAllianceGiftView.cs","content":"using FairyGUI;\nusing System;\nusing System.Collections.Generic;\nusing System.Linq;\n\nnamespace DayZ\n{\n    /// <summary>\n    /// 联盟礼物视图\n    /// </summary>\n    public class FBAllianceGiftView : PopupBaseView, IReusePanel\n    {\n        #region 常量\n        private const string PRESENT_ITEM_URL = \"ui://league/presentItem\";\n        private const string PRESENTLIST_URL = \"ui://league/C_presentlist\";\n        private const string PRESENT_LIST_URL = \"ui://league/presentList\";\n        private const string NOTIFICATION_REFRESH_ALLIANCE_GIFT = \"refresh_alliance_gift\";\n        private const string NOTIFICATION_RET_GET_REWARD_CMD = \"retGetRewardCmd\";\n        private const string FUNCTION_ALLIANCE_GIFT = \"AllianceGift\";\n        private const string EXCHANGE_TYPE_ALLIANCE_GIFT = \"37\";\n        private const int MAX_GIFT_REQUEST_COUNT = 10000;\n        #endregion\n\n        #region 私有字段\n        private GList _list;\n        private GTextField _giftLevel;\n        private GImage _giftLevelProgress;\n        private Controller _controller;\n        private Controller _giftTab;\n        private GProgressBar _boxProgress;\n        private GButton _boxBtn;\n        private GTextField _boxNameText;\n        private GObject _previewLocationPos;\n        private GButton _anonymSetBtn;\n        private CommonRedTipComponent _boxRedNode;\n        private GButton _getAllNormalBtn;\n        private GButton _normalGiftBtn;\n        private GButton _specialGiftBtn;\n        private CommonRedTipComponent _normalRedNode;\n        private CommonRedTipComponent _specialRedNode;\n        private GTextField _recvGiftCountText;\n        private GButton _recvLimitTipButton;\n        private GTextField _sendGiftCountText;\n        private GButton _sendLimitTipButton;\n        private PresentListView _presentView;\n\n        private int _currentTab;\n        private bool _firstInView;\n\n        private readonly List<FBAllianceGiftInfo> _data = new List<FBAllianceGiftInfo>(50);\n        private readonly List<FBAllianceGiftInfo> _boxes = new List<FBAllianceGiftInfo>(10);\n\n        private FBAllianceGiftController _giftController;\n        #endregion\n\n        #region 公共方法\n        /// <summary>\n        /// 创建联盟礼物视图实例\n        /// </summary>\n        public static FBAllianceGiftView Create()\n        {\n            return PopupViewController.getInstance().CreatePopupView<FBAllianceGiftView>(\"FBAllianceGiftView\");\n        }\n        #endregion\n\n        #region 生命周期方法\n        protected override void Awake()\n        {\n            base.Awake();\n            UIObjectFactory.SetPackageItemExtension(PRESENT_ITEM_URL, typeof(FBAllianceGiftCell));\n            UIObjectFactory.SetPackageItemExtension(PRESENTLIST_URL, typeof(PresentListView));\n            UIObjectFactory.SetPackageItemExtension(PRESENT_LIST_URL, typeof(GCommonGiftItem));\n        }\n\n        protected override void OnEnable()\n        {\n            base.OnEnable();\n            _giftController = FBAllianceGiftController.getInstance();\n            CCSafeNotificationCenter.sharedNotificationCenter().addObserver(this, RefreshView, NOTIFICATION_REFRESH_ALLIANCE_GIFT, null);\n            CCSafeNotificationCenter.sharedNotificationCenter().addObserver(this, RefreshView, NOTIFICATION_RET_GET_REWARD_CMD, null);\n        }\n\n        protected override void OnDisable()\n        {\n            base.OnDisable();\n\n            // 清理红点\n            if (_normalRedNode != null) _normalRedNode.SetData(\"\");\n            if (_specialRedNode != null) _specialRedNode.SetData(\"\");\n\n            // 移除通知观察者\n            CCSafeNotificationCenter.sharedNotificationCenter().removeObserver(this, NOTIFICATION_REFRESH_ALLIANCE_GIFT);\n            CCSafeNotificationCenter.sharedNotificationCenter().removeObserver(this, NOTIFICATION_RET_GET_REWARD_CMD);\n\n            // 移除 FairyGUI 事件监听器\n            RemoveEventListeners();\n\n            // 清理预览视图\n            if (_presentView != null)\n            {\n                _presentView.Dispose();\n                _presentView = null;\n            }\n\n            _giftController = null;\n        }\n\n        private void RemoveEventListeners()\n        {\n            if (_boxBtn != null) _boxBtn.onClick.Remove(OnPrevOrGetRewardClick);\n            if (_giftTab != null) _giftTab.onChanged.Remove(OnChangeTab);\n            if (_getAllNormalBtn != null) _getAllNormalBtn.onClick.Remove(OnGetAllNormalClick);\n            if (_mainView != null) _mainView.onTouchEnd.Remove(OnTouchEnded);\n            if (_anonymSetBtn != null) _anonymSetBtn.onChanged.Remove(OnChangeAnomyStatus);\n            if (_recvLimitTipButton != null) _recvLimitTipButton.onClick.Remove(OnShowRecvLimitTip);\n            if (_sendLimitTipButton != null) _sendLimitTipButton.onClick.Remove(OnShowSendLimitTip);\n        }\n\n        public override void InitializeFairyComponents()\n        {\n            base.InitializeFairyComponents();\n\n            _list = _mainView.GetChild(\"n24\").asList;\n            _list.SetVirtual();\n            _list.itemRenderer = ItemRenderer;\n\n            _giftLevel = _mainView.GetChild(\"n11\").asTextField;\n            _giftLevelProgress = _mainView.GetChild(\"n52\").asImage;\n\n            var button = _mainView.GetChild(\"n26\").asButton;\n            button.title = Global._lang(\"2000001028\");\n            button.onClick.Add(OnClickBuyButton);\n\n            _boxProgress = _mainView.GetChild(\"n4\").asProgress;\n            _boxBtn = _mainView.GetChild(\"n58\").asButton;\n            _boxBtn.onClick.Add(OnPrevOrGetRewardClick);\n\n            _controller = _mainView.GetController(\"c1\");\n\n            _giftTab = _mainView.GetController(\"c2\");\n            _giftTab.onChanged.Add(OnChangeTab);\n\n            _normalGiftBtn = _mainView.GetChild(\"n30\").asButton;\n            _specialGiftBtn = _mainView.GetChild(\"n31\").asButton;\n\n            _getAllNormalBtn = _mainView.GetChild(\"n69\").asButton;\n            _getAllNormalBtn.onClick.Add(OnGetAllNormalClick);\n\n            _normalRedNode = _normalGiftBtn.GetChild(\"n6\") as CommonRedTipComponent;\n            _specialRedNode = _specialGiftBtn.GetChild(\"n6\") as CommonRedTipComponent;\n\n            _mainView.onTouchEnd.Add(OnTouchEnded);\n\n            _boxRedNode = _mainView.GetChild(\"n65\") as CommonRedTipComponent;\n            _boxNameText = _mainView.GetChild(\"boxName\").asTextField;\n\n            _previewLocationPos = _mainView.GetChild(\"n68\");\n\n            _anonymSetBtn = _mainView.GetChild(\"select\").asButton;\n            _anonymSetBtn.onChanged.Add(OnChangeAnomyStatus);\n\n            var tipBtn = _mainView.GetChild(\"Detail\").asButton;\n            tipBtn.onClick.Add(OnClickProbTip);\n\n            _recvGiftCountText = _mainView.GetChild(\"n72\").asTextField;\n            _recvLimitTipButton = _mainView.GetChild(\"Detail1\").asButton;\n            _recvLimitTipButton.onClick.Add(OnShowRecvLimitTip);\n\n            _sendGiftCountText = _mainView.GetChild(\"n74\").asTextField;\n            _sendLimitTipButton = _mainView.GetChild(\"Detail2\").asButton;\n            _sendLimitTipButton.onClick.Add(OnShowSendLimitTip);\n\n            _mainView.GetChild(\"n7\").asTextField.text = Global._lang(\"77000202\");\n            _mainView.GetChild(\"n9\").asTextField.text = Global._lang(\"2000001784\");\n            _mainView.GetChild(\"n25\").asTextField.text = Global._lang(\"2000001026\");\n\n            CCCommonUtils.setButtonTitle(_normalGiftBtn, Global._lang(\"2000001716\"));\n            CCCommonUtils.setButtonTitle(_specialGiftBtn, Global._lang(\"2000001717\"));\n\n            CCCommonUtils.setButtonTitle(_getAllNormalBtn, Global._lang(\"83401193\"));\n            CCCommonUtils.setButtonTitle(_anonymSetBtn, Global._lang(\"ZH400040904\"));\n\n            setTitleName(Global._lang(\"90902027\"));\n\n            _anonymSetBtn.visible = FunctionOnController.Instance.CheckFunctionOn(FUNCTION_ALLIANCE_GIFT);\n        }\n\n        public override void Init(params object[] data)\n        {\n            base.Init(data);\n\n            _controller.selectedIndex = 0;\n            _firstInView = true;\n            LiBaoController.getInstance().getGoldExchangeDataByType(EXCHANGE_TYPE_ALLIANCE_GIFT, \"\");\n            FBAllianceGiftController.getInstance().getServerData(0, MAX_GIFT_REQUEST_COUNT);\n            RefreshView(null);\n\n            if (_presentView != null && _presentView.visible)\n                _presentView.setVisible(false);\n        }\n        #endregion\n\n        #region 私有方法 - 事件处理\n        private void OnShowRecvLimitTip(EventContext context)\n        {\n            int limit = _giftController.m_recGiftLimit;\n            CCCommonUtils.ShowDescriptionTip(_recvLimitTipButton, Global._lang_1(\"ZH400042889\", limit));\n        }\n\n        private void OnShowSendLimitTip(EventContext context)\n        {\n            int limit = _giftController.m_sendGiftLimit;\n            CCCommonUtils.ShowDescriptionTip(_sendLimitTipButton, Global._lang_1(\"ZH400042890\", limit));\n        }\n\n        private void OnClickProbTip()\n        {\n            string title = Global._lang(\"ZH400041797\");\n            string desc = Global._lang(\"ZH400041799\");\n            CCCommonUtils.ShowProbItemsView(title, desc, 4, \"\");\n        }\n\n        private void OnChangeAnomyStatus(EventContext context)\n        {\n            var cmd = new AGModifyUnnamedStatusCommand(_anonymSetBtn.selected ? 1 : 0);\n            cmd.send();\n        }\n\n        private void OnGetAllNormalClick(EventContext context)\n        {\n            _giftController.sendGetAllRewardCmd();\n        }\n\n        private void OnPrevOrGetRewardClick(EventContext context)\n        {\n            if (_boxes.Count > 0)\n            {\n                string boxId = _boxes[0].id;\n                _giftController.sendGetRewardCmd(0, boxId);\n            }\n            else\n            {\n                int giftLvl = _giftController.getOnLevel();\n                Alliance_box box = DataAtlasManager.Instance.GetDataWithTypeById<Alliance_box>(giftLvl.ToString());\n                var cmd = CommandBase.create(\"3rd.facebook.getbindreward\");\n                cmd.setSuccessCallback(GetRewardDataCallBack);\n                cmd.putParam(\"rewardId\", box.reward);\n                cmd.sendAndRelease();\n            }\n        }\n\n        private void GetRewardDataCallBack(NetResult obj)\n        {\n            List<ItemInfo> itemList = new List<ItemInfo>();\n            var dict = obj.Data as CCDictionary;\n            if (dict != null)\n            {\n                var rewards = dict[\"rewards\"] as CCArray;\n                if (rewards != null)\n                {\n                    CCCommonUtils.ParseServerReward(rewards, itemList);\n                    if (_presentView == null)\n                    {\n                        _presentView = PresentListView.create(itemList);\n                        _presentView.setPosition(_previewLocationPos.xy);\n                        _mainView.AddChild(_presentView);\n                    }\n                    else\n                    {\n                        _presentView.setVisible(true);\n                        _presentView.setData(itemList);\n                    }\n                }\n            }\n        }\n\n        private void OnTouchEnded(EventContext context)\n        {\n            if (_presentView != null && _presentView.visible\n                && !Global.isTouchInside(_presentView, context))\n            {\n                _presentView.setVisible(false);\n            }\n        }\n\n        private void OnChangeTab(EventContext context)\n        {\n            _currentTab = _giftTab.selectedIndex;\n            RefreshView(null);\n        }\n\n        private void OnClickBuyButton()\n        {\n            PopupViewController.getInstance().removeAllPopupView();\n            ActivityView.Create(\"DailyReward\");\n        }\n        #endregion\n\n        #region 私有方法 - 数据刷新\n        private void RefreshView(object p)\n        {\n            if (_giftController == null || !_giftController.getIsDataBack())\n            {\n                if (_boxRedNode != null) _boxRedNode.OnRedTipUpdate(0, RedTipStrategy.Number);\n                if (_normalRedNode != null) _normalRedNode.SetData(\"\");\n                if (_specialRedNode != null) _specialRedNode.SetData(\"\");\n                return;\n            }\n\n            _normalRedNode.SetData(\"Alliance_generalGift\");\n            _specialRedNode.SetData(\"Alliance_specialGift\");\n\n            if (_firstInView)\n            {\n                _firstInView = false;\n                CCCommonUtils.CheckAllianceGiftNums(out var nNum, out var sNum);\n                _giftTab.SetSelectedIndex(nNum < 1 && sNum > 0 ? 1 : 0);\n                _currentTab = _giftTab.selectedIndex;\n            }\n\n            UpdateGiftLimitTexts();\n            UpdateBoxInfo();\n            UpdateGiftList();\n            UpdateBars();\n\n            _anonymSetBtn.selected = _giftController.getUnnamedStatus() == 1;\n        }\n\n        private void UpdateGiftLimitTexts()\n        {\n            int recvLimit = _giftController.m_recGiftLimit;\n            int recvCount = recvLimit - _giftController.m_recGiftCount;\n            _recvGiftCountText.text = Global._lang_2(\"ZH400042887\", recvCount.ToString(), recvLimit.ToString());\n\n            int sendLimit = _giftController.m_sendGiftLimit;\n            int sendCount = sendLimit - _giftController.m_sendGiftCount;\n            _sendGiftCountText.text = Global._lang_2(\"ZH400042888\", sendCount.ToString(), sendLimit.ToString());\n        }\n\n        private void UpdateBoxInfo()\n        {\n            _boxes.Clear();\n            _boxes.AddRange(_giftController.m_fbAllianceBoxInfo.Values);\n            _boxes.Sort((l, r) => l.createTime.CompareTo(r.createTime));\n\n            int boxLevel = _boxes.Count > 0 ? _boxes[0].level : _giftController.getOnLevel();\n            _boxNameText.setString(Global._lang_1(\"2000001715\", boxLevel));\n            _boxRedNode.OnRedTipUpdate(_boxes.Count, RedTipStrategy.Number);\n        }\n\n        private void UpdateGiftList()\n        {\n            _data.Clear();\n            foreach (var gift in _giftController.m_fbAllianceGiftInfo.Values)\n            {\n                if (gift.type == _currentTab)\n                {\n                    _data.Add(gift);\n                }\n            }\n            _data.Sort((g1, g2) => g1.createTime.CompareTo(g2.createTime));\n            _list.numItems = _data.Count;\n            _controller.selectedIndex = _data.Count > 0 ? 0 : 1;\n        }\n\n        private void UpdateBars()\n        {\n            RefreshBar1();\n            RefreshBar2();\n        }\n\n        private void RefreshBar1()\n        {\n            _giftLevel.text = Global._lang_1(\"77100055\", _giftController.getOnLevel());\n            double max = _giftController.getOnMaxExp();\n            double value = _giftController.getOnCurrExp();\n            _giftLevelProgress.fillAmount = (float)(value / max);\n        }\n\n        private void RefreshBar2()\n        {\n            int curExp = _giftController.getBoxExp();\n            int maxExp = _giftController.getBoxMaxExp();\n            _boxProgress.setScaleX(curExp, maxExp);\n        }\n        #endregion\n\n        #region 公共方法 - 列表渲染\n        /// <summary>\n        /// 列表项渲染器\n        /// </summary>\n        public void ItemRenderer(int idx, GObject item)\n        {\n            if (idx >= _data.Count)\n                return;\n\n            FBAllianceGiftCell cell = item as FBAllianceGiftCell;\n            if (cell != null)\n                cell.SetData(idx, _data[idx]);\n        }\n\n        /// <summary>\n        /// 重置视图状态\n        /// </summary>\n        public void Reset()\n        {\n            _list.numItems = 0;\n        }\n        #endregion\n    }\n}\n","numLines":412,"startLine":1,"totalLines":412}},"sourceToolAssistantUUID":"6a962d43-bb97-4fba-aaf7-89d8bfc099b7","userType":"external","entrypoint":"claude-vscode","cwd":"E:\\WorkSpace\\RedAlert_SuperFormation","session