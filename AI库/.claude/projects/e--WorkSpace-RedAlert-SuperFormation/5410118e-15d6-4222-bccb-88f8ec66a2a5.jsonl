entView.setVisible(false);\n   249→        }\n   250→\n   251→        private void RefreshView(object p)\n   252→        {\n   253→            if (!FBAllianceGiftController.getInstance().getIsDataBack())\n   254→            {\n   255→                boxRedNode.OnRedTipUpdate(0, RedTipStrategy.Number);\n   256→                normalRedNode.SetData(\"\");\n   257→                specialRedNode.SetData(\"\");\n   258→                return;\n   259→            }\n   260→            normalRedNode.SetData(\"Alliance_generalGift\");\n   261→            specialRedNode.SetData(\"Alliance_specialGift\");\n   262→            if (firstInView)\n   263→            {\n   264→                firstInView = false;\n   265→                CCCommonUtils.CheckAllianceGiftNums(out var nNum, out var sNum);\n   266→                if (nNum < 1 && sNum > 0)\n   267→                {\n   268→                    giftTab.SetSelectedIndex(1);\n   269→                }\n   270→                else\n   271→                {\n   272→                    giftTab.SetSelectedIndex(0);\n   273→                }\n   274→                currentTab = giftTab.selectedIndex;\n   275→            }\n   276→\n   277→            int recvLimit = FBAllianceGiftController.getInstance().m_recGiftLimit;\n   278→            int recvCount = recvLimit - FBAllianceGiftController.getInstance().m_recGiftCount;\n   279→            recvGiftCountText.text = Global._lang_2(\"ZH400042887\", recvCount.ToString(), recvLimit.ToString());\n   280→\n   281→            int sendLimit = FBAllianceGiftController.getInstance().m_sendGiftLimit;\n   282→            int sendCount = sendLimit - FBAllianceGiftController.getInstance().m_sendGiftCount;\n   283→            sendGiftCountText.text = Global._lang_2(\"ZH400042888\", sendCount.ToString(), sendLimit.ToString());\n   284→\n   285→            boxes.Clear();\n   286→            boxes.AddRange(FBAllianceGiftController.getInstance().m_fbAllianceBoxInfo.Values);\n   287→            boxes.Sort((L, R) => L.createTime.CompareTo(R.createTime));\n   288→\n   289→            if (boxes.Count < 1)\n   290→            {\n   291→                boxNameText.setString(Global._lang_1(\"2000001715\",\n   292→                    FBAllianceGiftController.getInstance().getOnLevel()));\n   293→                //boxNumText.setString(\"\");\n   294→                //boxRedNode.setVisible(false);\n   295→                boxRedNode.OnRedTipUpdate(0, RedTipStrategy.Number);\n   296→            }\n   297→            else\n   298→            {\n   299→                //boxRedNode.setVisible(true);\n   300→                boxNameText.setString(Global._lang_1(\"2000001715\", boxes[0].level));\n   301→                //boxNumText.setString(boxes.Count.ToString());\n   302→                boxRedNode.OnRedTipUpdate(boxes.Count, RedTipStrategy.Number);\n   303→            }\n   304→\n   305→            data.Clear();\n   306→            foreach (var gift in FBAllianceGiftController.getInstance().m_fbAllianceGiftInfo.Values)\n   307→            {\n   308→                if (gift.type == currentTab)\n   309→                {\n   310→                    data.Add(gift);\n   311→                }\n   312→            }\n   313→\n   314→            data.Sort((gift1, gift2) => gift1.createTime.CompareTo(gift2.createTime));\n   315→            list.numItems = data.Count;\n   316→            refreshBar1();\n   317→            refreshBar2();\n   318→            this.controller.selectedIndex = data.Count > 0 ? 0 : 1;\n   319→\n   320→            anonymSetBtn.selected = FBAllianceGiftController.getInstance().getUnnamedStatus() == 1;\n   321→        }\n   322→        public void refreshBar1(object p = null)\n   323→        {\n   324→            giftLevel.text = Global._lang_1(\"77100055\", FBAllianceGiftController.getInstance().getOnLevel());\n   325→            double max = FBAllianceGiftController.getInstance().getOnMaxExp();\n   326→            double value = FBAllianceGiftController.getInstance().getOnCurrExp();\n   327→            giftLevelProgress.fillAmount = (float)(value / max);\n   328→            LogCommon.LogError(\"alliance gift box : {0}-{1}-{2}\", giftLevel.text, value, max);\n   329→        }\n   330→        private void refreshBar2()\n   331→        {\n   332→            int curExp = FBAllianceGiftController.getInstance().getBoxExp();\n   333→            int maxExp = FBAllianceGiftController.getInstance().getBoxMaxExp();\n   334→            boxProgress.setScaleX(curExp, maxExp);\n   335→        }\n   336→        private void OnClickBuyButton()\n   337→        {\n   338→            PopupViewController.getInstance().removeAllPopupView();\n   339→            ActivityView.Create(\"DailyReward\");\n   340→        }\n   341→\n   342→        public void ItemRenderer(int idx, GObject item)\n   343→        {\n   344→            if (idx >= data.Count)\n   345→                return;\n   346→\n   347→            FBAllianceGiftCell cell = item as FBAllianceGiftCell;\n   348→            if (cell != null)\n   349→                cell.SetData(idx, data[idx]);\n   350→        }\n   351→\n   352→        public void Reset()\n   353→        {\n   354→            this.list.numItems = 0;\n   355→        }\n   356→    }\n   357→}\n   358→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"uuid":"a6b56dde-b667-4ee2-971d-c92ada043d4e","timestamp":"2026-03-25T06:17:24.770Z","toolUseResult":{"type":"text","file":{"filePath":"e:\\WorkSpace\\RedAlert_SuperFormation\\Assets\\DevCodeFM\\IF\\DayZClasses\\view\\popup\\alliance\\AllianceGiftView\\FBAllianceGiftView.cs","content":"using FairyGUI;\nusing System;\nusing System.Collections.Generic;\n\nnamespace DayZ\n{\n    public 