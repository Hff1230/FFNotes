<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>桐城自摸麻将 - 局域网版</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Microsoft YaHei', sans-serif;
            background: linear-gradient(135deg, #1a472a 0%, #2d5a3d 100%);
            min-height: 100vh;
            color: #fff;
        }

        /* 大厅样式 */
        .lobby {
            max-width: 900px;
            margin: 0 auto;
            padding: 20px;
        }

        .lobby-header {
            text-align: center;
            padding: 20px;
            background: rgba(0,0,0,0.3);
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .lobby-header h1 {
            font-size: 2em;
            margin-bottom: 10px;
        }

        .login-form {
            display: flex;
            gap: 10px;
            justify-content: center;
            align-items: center;
        }

        .login-form input {
            padding: 10px 20px;
            font-size: 16px;
            border: none;
            border-radius: 5px;
            width: 200px;
        }

        .btn {
            padding: 10px 20px;
            font-size: 16px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-primary {
            background: #4CAF50;
            color: white;
        }

        .btn-primary:hover {
            background: #45a049;
        }

        .btn-danger {
            background: #f44336;
            color: white;
        }

        .btn-secondary {
            background: #607D8B;
            color: white;
        }

        .table-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px;
            padding: 20px;
        }

        .table-card {
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            border: 2px solid transparent;
        }

        .table-card:hover {
            background: rgba(255,255,255,0.2);
            transform: translateY(-2px);
        }

        .table-card.empty {
            border-color: #4CAF50;
        }

        .table-card.waiting {
            border-color: #FFC107;
        }

        .table-card.playing {
            border-color: #2196F3;
        }

        .table-card.full {
            border-color: #f44336;
            opacity: 0.7;
        }

        .table-card.new-table {
            background: rgba(76, 175, 80, 0.3);
            border: 2px dashed #4CAF50;
        }

        .table-number {
            font-size: 1.5em;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .table-status {
            font-size: 0.9em;
            color: #ccc;
        }

        .table-players {
            margin-top: 10px;
            font-size: 0.8em;
        }

        /* 牌桌列表中的小型圆桌布局 */
        .mini-table-layout {
            position: relative;
            width: 120px;
            height: 120px;
            margin: 10px auto;
        }

        .mini-table-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #2d5a3d 0%, #1a3d2a 100%);
            border: 2px solid #FFD700;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .mini-seat {
            position: absolute;
            text-align: center;
            width: 32px;
        }

        /* 逆时针顺序: 1(底) → 2(右) → 3(顶) → 4(左) */
        .mini-seat-1 { bottom: 0; left: 50%; transform: translateX(-50%); }
        .mini-seat-2 { right: 0; top: 50%; transform: translateY(-50%); }
        .mini-seat-3 { top: 0; left: 50%; transform: translateX(-50%); }
        .mini-seat-4 { left: 0; top: 50%; transform: translateY(-50%); }

        .mini-seat-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: bold;
            border: 2px solid #555;
            transition: all 0.3s;
            color: #fff;
        }

        .mini-seat-avatar.occupied {
            background: linear-gradient(135deg, #4CAF50, #2E7D32);
            border-color: #81C784;
        }

        .mini-seat-avatar:hover:not(.occupied) {
            background: rgba(255, 215, 0, 0.3);
            border-color: #FFD700;
            cursor: pointer;
        }

        .table-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 5px;
        }

        .table-id {
            color: #FFD700;
            font-size: 14px;
            font-weight: bold;
        }

        .table-mode-badge {
            font-size: 11px;
            padding: 2px 6px;
            border-radius: 4px;
            background: rgba(255, 215, 0, 0.2);
            color: #FFD700;
        }

        .table-footer {
            text-align: center;
            font-size: 12px;
            color: #ccc;
            margin-top: 10px;
        }

        .table-footer.full {
            color: #ff6b6b;
        }

        .table-footer.playing {
            color: #4dabf7;
        }

        /* 创建新桌卡片样式 */
        .create-table-card {
            background: linear-gradient(135deg, rgba(76, 175, 80, 0.3), rgba(46, 125, 50, 0.3));
            border: 2px dashed #4CAF50;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 200px;
        }

        .create-table-card .plus {
            font-size: 48px;
            color: #4CAF50;
            line-height: 1;
        }

        .create-table-card .text {
            color: #4CAF50;
            font-size: 16px;
            margin-top: 10px;
        }

        .create-table-card:hover {
            background: linear-gradient(135deg, rgba(76, 175, 80, 0.5), rgba(46, 125, 50, 0.5));
        }

        /* 游戏界面样式 */
        .game-container {
            display: none;
            width: 100vw;
            height: 100vh;
            position: relative;
        }

        .game-table {
            width: 100%;
            height: 100%;
            position: relative;
            background: radial-gradient(ellipse at center, #2d5a3d 0%, #1a472a 100%);
        }

        /* 玩家区域 */
        .player-area {
            position: absolute;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .player-area.bottom {
            bottom: 10px;
            left: 50%;
            transform: translateX(-50%);
            width: 80%;
        }

        .player-area.top {
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
        }

        .player-area.left {
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
        }

        .player-area.right {
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
        }

        .player-info {
            background: rgba(0,0,0,0.5);
            padding: 8px 15px;
            border-radius: 5px;
            margin-bottom: 5px;
            text-align: center;
        }

        .player-info.active {
            border: 2px solid #FFD700;
            box-shadow: 0 0 10px #FFD700;
        }

        .player-name {
            font-weight: bold;
        }

        .hand-count {
            font-size: 0.9em;
            color: #ccc;
        }

        /* 展示区 */
        .showed-area {
            display: flex;
            gap: 5px;
            margin: 5px 0;
            flex-wrap: wrap;
            justify-content: center;
        }

        .showed-card {
            width: 30px;
            height: 40px;
            background: #fff;
            border-radius: 3px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            color: #333;
        }

        .showed-card.fa {
            background: #FFD700;
        }

        .showed-card.gang {
            background: #90EE90;
        }

        /* 手牌区域 */
        .hand-area {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 4px;
            padding: 15px;
            background: linear-gradient(180deg, rgba(0,80,0,0.8) 0%, rgba(0,50,0,0.9) 100%);
            border-radius: 15px;
            max-width: 100%;
            box-shadow: inset 0 2px 10px rgba(0,0,0,0.5);
        }

        /* 麻将牌基础样式 */
        .card {
            width: 38px;
            height: 55px;
            background: linear-gradient(145deg, #FFFEF0 0%, #F5F0E0 30%, #E8E0D0 70%, #D8D0C0 100%);
            border-radius: 4px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.15s ease;
            position: relative;
            box-shadow:
                0 2px 0 #A09080,
                0 4px 0 #807060,
                0 6px 8px rgba(0,0,0,0.4),
                inset 0 1px 0 rgba(255,255,255,0.8),
                inset 0 -1px 0 rgba(0,0,0,0.1);
            border: 1px solid #C0B0A0;
        }

        .card:hover {
            transform: translateY(-8px) scale(1.05);
            box-shadow:
                0 4px 0 #A09080,
                0 8px 0 #807060,
                0 12px 16px rgba(0,0,0,0.5),
                inset 0 1px 0 rgba(255,255,255,0.8),
                inset 0 -1px 0 rgba(0,0,0,0.1);
            z-index: 10;
        }

        .card.selected {
            transform: translateY(-18px) scale(1.08);
            box-shadow:
                0 6px 0 #A09080,
                0 12px 0 #807060,
                0 18px 20px rgba(0,0,0,0.6),
                inset 0 1px 0 rgba(255,255,255,0.8),
                inset 0 -1px 0 rgba(0,0,0,0.1);
            z-index: 20;
        }

        .card.dragging {
            opacity: 0.6;
            transform: scale(1.1);
        }

        .card.drag-over {
            border-left: 3px solid #FFD700;
        }

        /* 万能牌样式 */
        .card.wild {
            background: linear-gradient(145deg, #FFFDE7 0%, #FFF9C4 50%, #FFE082 100%);
            border: 2px solid #FFD700;
            box-shadow:
                0 2px 0 #B8860B,
                0 4px 0 #8B6914,
                0 6px 8px rgba(255,215,0,0.5),
                inset 0 1px 0 rgba(255,255,255,0.9),
                0 0 15px rgba(255,215,0,0.6);
        }

        /* 牌面内容容器 */
        .card-face {
            width: 32px;
            height: 48px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #FFFEF8;
            border-radius: 2px;
            box-shadow: inset 0 0 3px rgba(0,0,0,0.1);
        }

        /* 筒子牌 - 圆点图案 */
        .card.tong .card-face {
            position: relative;
        }

        .card.tong .dot-container {
            width: 28px;
            height: 36px;
            display: grid;
            place-items: center;
        }

        .card.tong .dot {
            width: 8px;
            height: 8px;
            background: radial-gradient(circle at 30% 30%, #4FC3F7, #1976D2);
            border-radius: 50%;
            box-shadow: inset 0 -1px 2px rgba(0,0,0,0.3), 0 1px 1px rgba(255,255,255,0.5);
        }

        /* 1筒 */
        .card.tong.p1 .dot-container {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .card.tong.p1 .dot {
            width: 16px;
            height: 16px;
        }

        /* 2筒 */
        .card.tong.p2 .dot-container {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        /* 3筒 */
        .card.tong.p3 .dot-container {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: repeat(2, 1fr);
            gap: 2px;
        }
        .card.tong.p3 .dot:nth-child(1) { grid-column: 1; grid-row: 1; }
        .card.tong.p3 .dot:nth-child(2) { grid-column: 2; grid-row: 1; }
        .card.tong.p3 .dot:nth-child(3) { grid-column: 1 / 3; grid-row: 2; justify-self: center; }

        /* 4筒 */
        .card.tong.p4 .dot-container {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: repeat(2, 1fr);
            gap: 6px;
            padding: 4px;
        }

        /* 5筒 */
        .card.tong.p5 .dot-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-template-rows: repeat(3, 1fr);
            gap: 1px;
        }
        .card.tong.p5 .dot:nth-child(1) { grid-column: 1; grid-row: 1; }
        .card.tong.p5 .dot:nth-child(2) { grid-column: 3; grid-row: 1; }
        .card.tong.p5 .dot:nth-child(3) { grid-column: 2; grid-row: 2; width: 10px; height: 10px; }
        .card.tong.p5 .dot:nth-child(4) { grid-column: 1; grid-row: 3; }
        .card.tong.p5 .dot:nth-child(5) { grid-column: 3; grid-row: 3; }

        /* 6筒 */
        .card.tong.p6 .dot-container {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: repeat(3, 1fr);
            gap: 3px;
        }

        /* 7筒 */
        .card.tong.p7 .dot-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-template-rows: repeat(3, 1fr);
            gap: 1px;
        }
        .card.tong.p7 .dot:nth-child(1) { grid-column: 2; grid-row: 1; }
        .card.tong.p7 .dot:nth-child(2) { grid-column: 1; grid-row: 2; }
        .card.tong.p7 .dot:nth-child(3) { grid-column: 3; grid-row: 2; }
        .card.tong.p7 .dot:nth-child(4) { grid-column: 1; grid-row: 3; }
        .card.tong.p7 .dot:nth-child(5) { grid-column: 2; grid-row: 3; }
        .card.tong.p7 .dot:nth-child(6) { grid-column: 3; grid-row: 3; }
        .card.tong.p7 .dot:nth-child(7) { grid-column: 2; grid-row: 2; width: 10px; height: 10px; }

        /* 8筒 */
        .card.tong.p8 .dot-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-template-rows: repeat(3, 1fr);
            gap: 2px;
        }
        .card.tong.p8 .dot:nth-child(4) { grid-column: 2; grid-row: 2; display: none; }
        .card.tong.p8 .dot { width: 7px; height: 7px; }

        /* 9筒 */
        .card.tong.p9 .dot-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-template-rows: repeat(3, 1fr);
            gap: 3px;
        }
        .card.tong.p9 .dot { width: 7px; height: 7px; }

        /* 条子牌 - 竹节图案 */
        .card.tiao .card-face {
            padding: 3px;
        }
        .card.tiao .bamboo-container {
            display: flex;
            flex-direction: column;
            gap: 1px;
            align-items: center;
        }
        .card.tiao .bamboo-stick {
            width: 6px;
            height: 8px;
            background: linear-gradient(90deg, #2E7D32, #4CAF50, #2E7D32);
            border-radius: 1px;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.3);
        }
        .card.tiao .bamboo-stick.short { height: 6px; }
        .card.tiao .bamboo-row {
            display: flex;
            gap: 2px;
        }

        /* 万子牌 */
        .card.wan .card-face {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 1px;
        }
        .card.wan .wan-num {
            font-size: 16px;
            font-weight: bold;
            color: #B71C1C;
            line-height: 1;
            font-family: 'KaiTi', 'STKaiti', serif;
        }
        .card.wan .wan-char {
            font-size: 12px;
            color: #B71C1C;
            font-weight: bold;
            font-family: 'KaiTi', 'STKaiti', serif;
        }

        /* 风牌 */
        .card.feng .card-face {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .card.feng .feng-char {
            font-size: 22px;
            font-weight: bold;
            color: #1565C0;
            font-family: 'KaiTi', 'STKaiti', serif;
            text-shadow: 1px 1px 1px rgba(0,0,0,0.2);
        }

        /* 箭牌 */
        .card.jian .card-face {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .card.jian .jian-char {
            font-size: 22px;
            font-weight: bold;
            font-family: 'KaiTi', 'STKaiti', serif;
        }

        .card.jian.zhong .jian-char {
            color: #C62828;
            text-shadow: 0 0 3px rgba(198,40,40,0.5);
        }
        .card.jian.fa .jian-char {
            color: #2E7D32;
            text-shadow: 0 0 3px rgba(46,125,50,0.5);
        }
        .card.jian.bai .jian-char {
            color: #333;
            text-shadow: 1px 1px 0 #666, -1px -1px 0 #fff;
        }

        /* 兼容旧样式（用于其他区域显示） */
        .card-rank {
            font-size: 16px;
            font-weight: bold;
        }
        .card-suit {
            font-size: 10px;
            color: #666;
        }

        /* 中央信息区 */
        .center-info {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            background: rgba(0,0,0,0.6);
            padding: 20px;
            border-radius: 10px;
        }

        .wild-card-info {
            margin-bottom: 15px;
        }

        .wild-card-info .label {
            font-size: 14px;
            color: #ccc;
        }

        .wild-card-info .card-display {
            font-size: 24px;
            font-weight: bold;
            color: #FFD700;
        }

        .deck-count {
            font-size: 14px;
            color: #ccc;
        }

        .game-time {
            font-size: 14px;
            color: #FFD700;
            margin-top: 5px;
        }

        /* 操作按钮 */
        .action-buttons {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin-top: 10px;
            flex-wrap: wrap;
        }

        .action-btn {
            padding: 8px 20px;
            font-size: 14px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .action-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .action-btn.play {
            background: #4CAF50;
            color: white;
        }

        .action-btn.fa {
            background: #FFD700;
            color: #333;
        }

        .action-btn.gang {
            background: #9C27B0;
            color: white;
        }

        .action-btn.hu {
            background: #f44336;
            color: white;
        }

        /* 聊天区域 */
        .chat-area {
            position: absolute;
            bottom: 200px;
            right: 10px;
            width: 200px;
            background: rgba(0,0,0,0.5);
            border-radius: 10px;
            padding: 10px;
        }

        .chat-messages {
            height: 150px;
            overflow-y: auto;
            font-size: 12px;
            margin-bottom: 10px;
        }

        .chat-input {
            display: flex;
            gap: 5px;
        }

        .chat-input input {
            flex: 1;
            padding: 5px;
            border: none;
            border-radius: 3px;
        }

        /* 准备界面 */
        .ready-panel {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(0,0,0,0.8);
            padding: 30px;
            border-radius: 10px;
            text-align: center;
            z-index: 100;
        }

        .ready-panel h2 {
            margin-bottom: 20px;
        }

        .seat-list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin-bottom: 20px;
        }

        .seat-item {
            background: rgba(255,255,255,0.1);
            padding: 10px;
            border-radius: 5px;
        }

        .seat-item.occupied {
            background: rgba(76, 175, 80, 0.3);
        }

        .seat-item.me {
            border: 2px solid #FFD700;
        }

        /* 玩家列表面板 */
        .players-panel {
            position: absolute;
            top: 10px;
            left: 10px;
            background: rgba(0,0,0,0.5);
            padding: 15px;
            border-radius: 10px;
        }

        .players-panel h3 {
            margin-bottom: 10px;
            font-size: 14px;
        }

        .player-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 5px 0;
            font-size: 13px;
        }

        .player-item .seat {
            background: rgba(255,255,255,0.2);
            padding: 2px 8px;
            border-radius: 3px;
            font-size: 12px;
        }

        .player-item .ready-status {
            color: #4CAF50;
            font-size: 12px;
        }

        .player-item .not-ready {
            color: #999;
        }

        /* 隐藏 */
        .hidden {
            display: none !important;
        }

        /* 当前玩家指示 */
        .current-turn {
            color: #FFD700 !important;
            font-weight: bold;
        }

        .current-turn::before {
            content: '▶ ';
            color: #FFD700;
        }

        /* 发牌动画 */
        .deal-animation {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }

        .deal-piles {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
        }

        .deal-pile {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .deal-pile-label {
            color: #fff;
            margin-bottom: 10px;
            font-size: 14px;
        }

        .deal-pile-cards {
            display: flex;
            flex-wrap: wrap;
            width: 120px;
            gap: 2px;
        }

        .deal-card-back {
            width: 25px;
            height: 35px;
            background: linear-gradient(135deg, #1a237e 0%, #283593 100%);
