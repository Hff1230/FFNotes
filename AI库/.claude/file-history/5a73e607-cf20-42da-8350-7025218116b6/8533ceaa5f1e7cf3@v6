        .card.selected {
            transform: translateY(-12px);
            box-shadow:
                1px 0 0 #c8c0b8,
                0 4px 0 #d0c8c0,
                0 7px 0 #c0b8b0,
                0 10px 0 #b0a8a0,
                0 13px 10px rgba(0,0,0,0.4);
