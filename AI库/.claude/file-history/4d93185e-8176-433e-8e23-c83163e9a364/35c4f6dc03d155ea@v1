        public int calcEliteCurrentSoldier(int index)
        {
            // if (m_heros[index].armyId.empty())
            // {
            //     return 0;
            // }
            // 这里得使用和服务器相同的计算准则，这样才能进行预测。
            int asPlayerMaxSoldiers = getMaxNum();
            //
            asPlayerMaxSoldiers += (int)(EffectController.getInstance().getEffectValueByNumOnlyApplicableToFormation(56, getIndex()));
            //
            int singleMax = (int)(Math.Ceiling(((double)asPlayerMaxSoldiers) / 3));
            asPlayerMaxSoldiers = singleMax * 3;

            int average = asPlayerMaxSoldiers / 3;
            int pos = (int)(EffectController.getInstance().getEffectValueByNumOnlyApplicableToEliteFormationLine(56, getIndex(), index));
            m_heros[index].maxMarch = pos + average;
            return m_heros[index].maxMarch;
        }

