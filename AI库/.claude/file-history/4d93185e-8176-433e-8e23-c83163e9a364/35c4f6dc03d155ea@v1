        /// <summary>
        /// 检查英雄数据是否发生变更
        /// </summary>
        /// <returns>如果英雄数据发生变更返回true，否则返回false</returns>
        public bool hasDirtyHeros()
        {
            // 检查数组长度是否一致
            if (m_heros.Length != m_herosTemp.Length)
            {
                return true;
            }
            // 逐个比较英雄数据
            for (int i = 0; i < m_heros.Length; i++)
            {
                // 比较英雄ID、军队ID、数量和等级
                if (m_heros[i].heroId != m_herosTemp[i].heroId)
                {
                    return true;
                }
            }
            return false;
        }

        /// <summary>
        /// 检查士兵数据是否发生变更
        /// </summary>
        /// <returns>如果士兵数据发生变更返回true，否则返回false</returns>
        public bool hasDirtySolders()
        {
            // 检查字典键数量是否一致
            if (m_soldiers.Count != m_soldiersTemp.Count)
            {
                return true;
            }

            // 检查每个键对应的士兵列表
            foreach (var kvp in m_soldiers)
            {
                if (!m_soldiersTemp.TryGetValue(kvp.Key, out var tempList))
                {
                    return true;
                }

                var currentList = kvp.Value;
                if (currentList.Count != tempList.Count)
                {
                    return true;
                }

                // 逐个比较士兵数据
                for (int i = 0; i < currentList.Count; i++)
                {
                    if (currentList[i] == null && tempList[i] == null)
                    {
                        continue;
                    }
                    // 比较军队ID和数量
                    if (currentList[i].armyId != tempList[i].armyId ||
                        currentList[i].count != tempList[i].count)
                    {
                        return true;
                    }
                }
            }
            return false;
        }

        /// <summary>
        /// 检查无人机数据是否发生变更
        /// </summary>
        /// <returns>如果无人机数据发生变更返回true，否则返回false</returns>
        public bool hasDirtyUavs()
        {
            // 比较无人机UID
            return m_uavUid != uavUidTemp;
        }

        /// <summary>
        /// 检查英雄、士兵或无人机数据是否发生变更
        /// </summary>
        /// <returns>如果任何一种数据发生变更返回true，否则返回false</returns>
        public bool hasDirtyHerosOrSoldersOrUavs()
        {
            return hasDirtyHeros() || hasDirtySolders() || hasDirtyUavs();
        }

