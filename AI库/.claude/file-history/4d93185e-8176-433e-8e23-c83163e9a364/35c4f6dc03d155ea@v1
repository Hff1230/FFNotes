                                 marchIt.TargetType == WorldCityType.CityRange)
                        {
                            type = MarchActionType.Defense;
                        }
                        else if (marchIt.TargetType == WorldCityType.tile_allianceAreaBuild)
                        {
                            type = MarchActionType.Collect;
                        }

                        else
                        {
                            type = MarchActionType.Defense;
                        }
                        if (marchIt.TargetType == WorldCityType.Tile_allianceArea
                            || marchIt.TargetType == WorldCityType.TERRITORY_EXPANSION_BANNER)
                        {
                            if (queueIt.type == (int)QueueType.TYPE_BUILDING_TERRITORY)
