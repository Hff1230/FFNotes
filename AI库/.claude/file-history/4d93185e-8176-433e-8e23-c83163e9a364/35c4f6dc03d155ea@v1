        public int GetTroopAddRateByArmyCount(int current, int max)
        {
            return getTroopAddRateByArmyCount(current, max);
        }
        private int getTroopAddRateByArmyCount(int current, int max)
        {
            var rate = 100.0f * current / max;
            var dict = DataAtlasManager.Instance.GetDataWithType<New_hero_upgrade>();
            using (var itor = dict.GetEnumerator())
            {
                while (itor.MoveNext())
                {
                    var child = itor.Current.Value as New_hero_upgrade;
                    if (rate >= child.min && rate < child.max)
                    {
#if UNITY_EDITOR
                        //                LogCommon.LogError("英雄兵力系数>> current:{0} ; max:{1} ; Rate :{2}", current, max, child.proportion);
#endif
                        return child.proportion;
                    }
                }
            }
#if UNITY_EDITOR
            //  LogCommon.LogError("英雄兵力系数>> current:{0} ; max:{1} ; Rate :{2}", current, max, 100);
#endif
            return 100;
        }



