        public double getMarchTime(double dis, WorldCityType type, MarchMethodType marchType, float slowDown)
        {
            float spd = getMinSpeed();

            int buildType = 0;
            var info = FunBuildController.getInstance().getFunBuildInfoByUuid(getUuid());
            if (info != null)
            {
                buildType = info.type;
            }
            else
            {
                return 0;
            }

            if (FunBuildController.getInstance().isSpecialCollectFormationBuild(info.type))
            {
                spd = getCollectMinSpeed();
            }

            //    double k1 = GlobalData.shared().worldConfig.distance[0];
            //    double k2 = GlobalData.shared().worldConfig.distance[1];
            //    double k4 = GlobalData.shared().worldConfig.distance[3];
            double k1 = DataConfig2.dataConfig2.world_marchtime["k1"].asDouble();
            double k2 = DataConfig2.dataConfig2.world_marchtime["k2"].asDouble();
            double k4 = DataConfig2.dataConfig2.world_marchtime["k4"].asDouble();

            float effect = (float)Math.Max(1.0 + EffectController.getInstance().getEffectValueByNumApplicableToGlobal(60) / 100.0, 0.001);
            if (type == WorldCityType.FieldMonster)
            {//野怪
                effect = (float)Math.Max(1.0 + (EffectController.getInstance().getEffectValueByNumApplicableToGlobal(60) + EffectController.getInstance().getEffectValueByNumApplicableToGlobal(Global.MONSTER_SPEED_EFFECT) + EffectController.getInstance().getEffectValueByNumApplicableToGlobal(Global.WORLD_FIELD_MONSTER_TIME)) / 100.0, 0.001);
            }
            else if (WorldCityType.CityTile == type)
            {//城市
                effect = (float)Math.Max(1.0 + (EffectController.getInstance().getEffectValueByNumApplicableToGlobal(60) + FreeBuildTroopsController.getInstance().getTargetEffect398() + EffectController.getInstance().getEffectValueByNumApplicableToGlobal(Global.CITY_SPEED_EFFECT)) / 100.0, 0.001);
            }
            else if (WorldCityType.CampTile == type)
            {//营地
                effect = (float)Math.Max(1.0 + (EffectController.getInstance().getEffectValueByNumApplicableToGlobal(60) + EffectController.getInstance().getEffectValueByNumApplicableToGlobal(Global.CAMP_SPEED_EFFECT)) / 100.0, 0.001);
            }
            else if (WorldCityType.ResourceTile == type)
            {//采集
                effect = (float)Math.Max(1.0 + (EffectController.getInstance().getEffectValueByNumApplicableToGlobal(60) + EffectController.getInstance().getEffectValueByNumApplicableToGlobal(Global.PRODUCT_SPEED_EFFECT)) / 100.0, 0.001);
            }

            if (MarchMethodType.MethodScout == marchType || MarchMethodType.MethodMoTianLunMarch == marchType || MarchMethodType.Method_AIRes == marchType)
            {
                effect += (float)(EffectController.getInstance().getEffectValueByNumApplicableToGlobal(94) / 100.0);//提高侦查的移动速度
            }
            else if (marchType == MarchMethodType.MethodUnion)
            {
                effect += EffectController.getInstance().getEffectValueByNumApplicableToGlobal(Global.WORLD_UNIN_EFFECT) / 100.0f;//参与集结时行军速度
                effect += EffectController.getInstance().getEffectValueByNumApplicableToGlobal(Global.TAKE_PART_IN_RALLY_MARCH_SPEED) / 100.0f;//参与集结时行军速度
            }
            else if (marchType == MarchMethodType.MethodYuanSolider)
            {
                effect += (float)EffectController.getInstance().getEffectValueByNumApplicableToGlobal(Global.WORLD_YUAN_EFFECT) / 100.0f;
                effect += (float)EffectController.getInstance().getEffectValueByNumApplicableToGlobal(Global.HELP_ALLIANCE_MARCH_SPEED) / 100.0f;//援助盟友时行军速度
            }
            else if (MarchMethodType.Method_bounty == marchType || MarchMethodType.Method_Solder == marchType)
            {
                effect += (float)EffectController.getInstance().getEffectValueByNumApplicableToGlobal(Global.WORLD_YUAN_EFFECT) / 100.0f;
            }
            else if (MarchMethodType.Method_USER_WORLD_BUILDING_MARCH == marchType || MarchMethodType.Method_TERRITORY_ASSEMBLE_MARCH == marchType)
            {//攻打城市建筑
                effect += EffectController.getInstance().getEffectValueByNumApplicableToGlobal(Global.WORLD_BUILD_MARCH_SPEED_755) / 100.0f;
            }
            else if (MarchMethodType.Method_DOMAIN_FIGHT_MARCH == marchType)
            {
                effect += EffectController.getInstance().getEffectValueByNumApplicableToGlobal(Global.WORLD_DOMAIN_MARCH_SPEED_753) / 100.0f;
                //目标是地块
            }
            effect += EffectController.getInstance().getEffectValueByNumOnlyApplicableToFormation(847, getIndex()) / 100.0f;
            double time = (Math.Pow(dis, k1) * k2 / (spd * effect));
            if (marchType == MarchMethodType.MethodDeal)
            {
                time = Math.Pow(dis, k1) * k4;
                float totalEffectValue = 0f;

                totalEffectValue += EffectController.getInstance().getEffectValueByNumApplicableToGlobal(Global.ALLIANCE_TRADE_SPEED_TIME_EFFECT);
                totalEffectValue += EffectController.getInstance().getEffectValueByNumApplicableToGlobal(Global.HELP_ALLIANCE_MARCH_SPEED);//援助盟友时行军速度
                time = time * 1.0 / (1.0 + totalEffectValue / 100.0);
            }
            time = time * 1000 * slowDown;
            if (MarchMethodType.MethodScout != marchType && MarchMethodType.MethodYuanSolider != marchType && MarchMethodType.Method_missileAttack != marchType)
            {
                effect = EffectController.getInstance().getEffectValueByNumApplicableToGlobal(23);
                time = time * (1.0 - Math.Min(effect, 99.0) / 100.0);
            }
            if (slowDown != 1)
            {//现阶段 只有两处调用这个代码的地方slowDown表示的是黑土地的减速效果 当不为1时可以认为在黑土地上
                time -= time * (EffectController.getInstance().getEffectValueByNumApplicableToGlobal(565) / 100);
            }

            return (int)(time);
        }

