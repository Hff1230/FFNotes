        public double calculateDemoSingleline(ref string armyId, int count)
        {
            double k1 = DataConfig2.dataConfig2.cheng_fang_zhi["k1"].asDouble();
            double k2 = DataConfig2.dataConfig2.cheng_fang_zhi["k2"].asDouble();
            double k3 = DataConfig2.dataConfig2.cheng_fang_zhi["k3"].asDouble();
            double k4 = DataConfig2.dataConfig2.cheng_fang_zhi["k4"].asDouble();

            /*
                勇士攻城值=部队战力^k1+k2
                车辆攻城值=（部队战力^k1+k2） k3
                射手攻城值=（部队战力^k1+k2） k4

                每个小组单独计算后，3组相加 小数点后向下取整。

             WARRIOR = 1, // 勇士
             BATTLECAR, // 战车
             SHOOTER, //  射手
               */
            var armyinfo = ArmyController.getInstance().getArmyInfo(armyId);
            if (armyinfo == null || count == 0)
            {
                return 0;
            }
            double demolition = 0;
            float rate = 1f;
            if (armyinfo.m_armType == (int)SoldierType.WARRIOR)
            {
                demolition = Math.Pow(armyinfo.power * count, k1) + k2;
                rate += EffectController.getInstance().getEffectValueByNumApplicableToGlobal(964) / 100f;
            }
            else if (armyinfo.m_armType == (int)SoldierType.BATTLECAR)
            {
                demolition = (Math.Pow(armyinfo.power * count, k1) + k2) * k3;
                rate += EffectController.getInstance().getEffectValueByNumApplicableToGlobal(965) / 100f;
            }
            else if (armyinfo.m_armType == (int)SoldierType.SHOOTER)
            {
                demolition = (Math.Pow(armyinfo.power * count, k1) + k2) * k4;
                rate += EffectController.getInstance().getEffectValueByNumApplicableToGlobal(966) / 100f;
            }
            return demolition * (rate);
        }

        public float getEffectValueAttact()
        {
            double demolition = 0;
            foreach (var soldierList in m_soldiers.Values)
            {
                foreach (var soldier in soldierList)
                {
                    demolition += calculateDemoSingleline(ref soldier.armyId, soldier.count);
                }
            }
            return (float)demolition;
        }

