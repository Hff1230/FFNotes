        public int getLoad(FBLoadType loadType, string para = "")
        {
            float curLoadNum = 0.0f;

            int buildType = 0;
            var info = FunBuildController.getInstance().getFunBuildInfoByUuid(getUuid());
            if (info != null)
            {
                buildType = info.type;
            }

            if (FunBuildController.getInstance().isSpecialCollectFormationBuild(buildType))
            {
                curLoadNum += (float)info.getVecValueByVecIndex(1);
            }
            else
            {
                foreach (var soldierList in m_soldiers.Values)
                {
                    foreach (var soldier in soldierList)
                    {
                        curLoadNum += getLoadByArmyId(soldier.armyId, soldier.count, loadType, para);
                    }
                }
            }
            // 职业加成放在最外面
            float rate = 1f;
            if (loadType == FBLoadType.FBLoadType_CollectResource)
            {
                rate += (float)(EffectController.getInstance().getEffectValueByNumApplicableToGlobal(Global.ARMY_LOAD_COLLECT_EFFECT) / 100.0);//只针对采集
                rate += (float)(EffectController.getInstance().getEffectValueByNumOnlyApplicableToFormation(Global.ARMY_LOAD_COLLECT_EFFECT, m_index) / 100.0);
            }

            curLoadNum *= rate;


            if (loadType == FBLoadType.FBLoadType_CollectResource)
            {
                if (Global.atoi(para) == (int)WorldResourceType.Oil)
                    curLoadNum = (int)(curLoadNum / ResourceController.getInstance().getOilWeight());
                else if (Global.atoi(para) == (int)WorldResourceType.Iron)
                    curLoadNum = (int)(curLoadNum / ResourceController.getInstance().getIronWeight());
                else if (Global.atoi(para) == (int)WorldResourceType.Wood)
                    curLoadNum = (int)(curLoadNum / ResourceController.getInstance().getWoodWeight());
                else if (Global.atoi(para) == (int)WorldResourceType.Food)
                    curLoadNum = (int)(curLoadNum / ResourceController.getInstance().getFoodWeight());
                else if (Global.atoi(para) == (int)WorldResourceType.Silver)
                    curLoadNum = (int)(curLoadNum / ResourceController.getInstance().getSilverWeight());
                else if (Global.atoi(para) == (int)WorldResourceType.Gold)
                    curLoadNum = (int)(curLoadNum / ResourceController.getInstance().getGoldWeight());
                else if (Global.atoi(para) == (int)WorldResourceType.BloodShard)
                    curLoadNum = (int)(curLoadNum / ResourceController.getInstance().getBloodShardWeight());
            }

            if (loadType == FBLoadType.FBLoadType_CollectResource && Global.atoi(para) != (int)WorldResourceType.Gold && Global.atoi(para) != (int)WorldResourceType.BloodShard)
            {
                //curLoadNum += 200;
            }

            return (int)curLoadNum;
        }

