        public object getCmdData()
        {
            CCDictionary formDict = new CCDictionary();
            CCArray array_hero = CCArray.create();
            for (int i = 0; i < m_heros.Length; i++)
            {
                if (m_heros[i] == null || string.IsNullOrEmpty(m_heros[i].heroId))
                {
                    continue;
                }
                CCDictionary heroDict = new CCDictionary();
                heroDict.setObject(m_heros[i].heroId, "heroId");
                array_hero.Add(heroDict);
            }

            CCArray array_soldier = CCArray.create();
            foreach (var item in m_soldiers.Values)
            {
                foreach (var it in item)
                {
                    if (it.count > 0)
                    {
                        CCDictionary sodierDict = new CCDictionary();
                        sodierDict.setObject(it.armyId, "armyId");
                        sodierDict.setObject(it.count, "count");
                        array_soldier.Add(sodierDict);
                    }
                }
            }
            CCDictionary drone = new CCDictionary();
            drone.setObject(m_uavUid, "droneUuid");

            formDict.setObject((int)formType, "type");
            formDict.setObject(m_index, "index");
            formDict.setObject(array_hero, "hero");
            formDict.setObject(array_soldier, "soldiers");
            formDict.setObject(drone, "drone");
            formDict.setObject(m_name, "name");
            if (!string.IsNullOrEmpty(miningUid))
            {
                formDict.setObject(miningUid, "miningUid");
            }

            return formDict;
        }
        public void parseHeroSoldierAndUav(CCDictionary dict)
        {
            //Debug.LogError("formation"+dict.ToJson());
            clearHeros();
            clearSoldiers();
            if (dict.ContainsKey("name"))
                m_name = dict.valueForKey("name");
            if (dict.ContainsKey("type"))
                formType = (SuperFormType)dict.valueForKey("type").intValue();
            if (dict.ContainsKey("index"))
                m_index = dict.valueForKey("index").intValue();
            if (dict.ContainsKey("uuid"))
                m_uuid = dict.valueForKey("uuid").getCString();
            CCArray heros = (CCArray)(dict.objectForKey("hero"));
            CCArray.CCARRAY_FOREACH(heros, obj =>
            {
                CCDictionary h = (CCDictionary)(obj);
                if (h != null)
                {
                    string heroId = h.valueForKey("heroId");
                    if (string.IsNullOrEmpty(heroId))
                        return;
                    int starLv = h.valueForKey("starLv").intValue();
                    int heroLv = h.valueForKey("level").intValue();
                    var xmlInfo = FBHeroXMLInfoData.Get(heroId);
                    int index = xmlInfo.icon_type - 1;
                    m_heros[index].heroId = heroId;
                    m_heros[index].heroLv = heroLv;
                    m_heros[index].starLv = starLv;
                    m_heros[index].heroDict = h;
                }
            });
            CCArray soldiers = (CCArray)(dict.objectForKey("soldiers"));
            CCArray.CCARRAY_FOREACH(soldiers, obj =>
            {
                CCDictionary h = (CCDictionary)(obj);
                if (h != null)
                {
                    string armyId = h.valueForKey("armyId");
                    int count = h.valueForKey("count").intValue();
                    int armyType = CCCommonUtils.getArmysInfo(armyId).icon_type;
                    if (!m_soldiers.ContainsKey(armyType) || m_soldiers[armyType] == null)
                        m_soldiers[armyType] = new List<SuperFormationSoldierMarch>();
                    m_soldiers[armyType].Add(new SuperFormationSoldierMarch(armyId, count, h));
                }
            });
            m_uavUid = "";
            if (dict.ContainsKey("drone"))
            {
                uavDict = dict.ObjectForKey("drone") as CCDictionary;
                m_uavUid = uavDict.StringValueForKey("droneUuid");
            }
        }


