        public MarchActionType GetMarchType()
        {
            MarchActionType type = MarchActionType.None;

            if (getState() == 0)///没有任何行动
            {
                type = MarchActionType.Home;
            }
            else
            {
                var marchIt = WorldController.getInstance().getMarchInfoByFormationUuid(getUuid());
                if (marchIt == null)///没有行军线信息，可能处于集结中
                {
                    //集结
                    //var cityData = WorldCityController.getInstance().GetWorldCityData(this.);
                    type = MarchActionType.Fight;
                }
                else
                {
                    var queueIt = QueueController.getInstance().getQueueInfoByUuid(marchIt.Uuid);

                    if (marchIt.StateType == MarchStateType.StateMarch)///行军中
                    {
                        if (marchIt.MarchType == MarchMethodType.MethodRally)
                        {
                            type = MarchActionType.InitiateRallyMarch;
                        }
                        else if (marchIt.MarchType == MarchMethodType.MethodUnion)
                        {
                            type = MarchActionType.JoinRally2Home;
                        }
                        else
                        {
                            type = MarchActionType.March;
                        }
                    }
                    else if (marchIt.StateType == MarchStateType.StateReturn)///返回中
                    {
                        type = MarchActionType.Return;
                    }
                    else if (marchIt.StateType == MarchStateType.StateOccupy)
                    {
                        if (marchIt.MarchType == MarchMethodType.MethodRally)
                        {
                            if (marchIt.StartStamp != 0 && marchIt.EndStamp != 0
                                && marchIt.AllianceTeamCreateTime > 0 && marchIt.EndAction == MarchEndAction.MarchActionNone
                                && marchIt.SpeedX == 0 && marchIt.SpeedY == 0)
                            {
                                type = MarchActionType.InitiateRally;
                            }
                            else if (marchIt.TargetType == WorldCityType.tile_one_level_city ||
                                marchIt.TargetType == WorldCityType.tile_one_level_city_range ||
                                marchIt.TargetType == WorldCityType.tile_two_level_city ||
                                marchIt.TargetType == WorldCityType.tile_two_level_city_range ||
                                marchIt.TargetType == WorldCityType.Throne ||
                                marchIt.TargetType == WorldCityType.ThroneRange ||
                                marchIt.TargetType == WorldCityType.Trebuchet ||
                                marchIt.TargetType == WorldCityType.TERRITORY_BANNER ||
                                marchIt.TargetType == WorldCityType.VILLAGE)
                            {
                                /*string json = Newtonsoft.Json.JsonConvert.SerializeObject(marchIt, newtonsoft.Json.JsonSerializerSettings()
