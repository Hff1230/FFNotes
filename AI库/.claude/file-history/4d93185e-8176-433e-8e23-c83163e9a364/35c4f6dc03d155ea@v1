                                    ReferenceLoopHandling = Newtonsoft.Json.ReferenceLoopHandling.Ignore
                                });
                                UnityEngine.Debug.LogWarning(">>> \n" + json);*/

                                type = MarchActionType.Defense;
                            }
                            else if (
                                marchIt.TargetType == WorldCityType.Blood_Area_Big ||
                                marchIt.TargetType == WorldCityType.Blood_Area_Small)
                            {
                                type = MarchActionType.Collect;
                            }

                            else
                            {
                                type = MarchActionType.InitiateRally;
                            }
                        }
                        else if (marchIt.MarchType == MarchMethodType.MethodUnion)
                        {
                            if (!string.IsNullOrEmpty(marchIt.TeamUid))
                            {
                                var initMarchIt = WorldController.getInstance().getMarchInfo(marchIt.TeamUid);
                                if (initMarchIt != null
                                    && initMarchIt.MarchType == MarchMethodType.MethodRally
                                    && initMarchIt.StartStamp != 0 && initMarchIt.EndStamp != 0
                                    && initMarchIt.AllianceTeamCreateTime > 0 && initMarchIt.EndAction == MarchEndAction.MarchActionNone
                                    && initMarchIt.SpeedX == 0 && initMarchIt.SpeedY == 0)
                                {
                                    type = MarchActionType.InitiateRally;
                                }
                                else
                                {
                                    var it = initMarchIt ?? marchIt;
                                    if (it.TargetType == WorldCityType.tile_one_level_city ||
