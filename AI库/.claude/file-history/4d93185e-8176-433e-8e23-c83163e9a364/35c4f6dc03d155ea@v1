                        rate += EffectController.getInstance().getEffectValueByNumOnlyApplicableToFormation(898, m_index) / 100.0f;
                    }
                }
            }
            else if (loadType == FBLoadType.FBLoadType_AttackCity)
            {
                rate += EffectController.getInstance().getEffectValueByNumApplicableToGlobal(87) / 100;
                rate += EffectController.getInstance().getEffectValueByNumOnlyApplicableToFormation(87, m_index) / 100.0f;
            }

            //负重
            rate += EffectController.getInstance().getEffectValueByNumApplicableToGlobal(1300) / 100.0f;
            rate += EffectController.getInstance().getEffectValueByNumOnlyApplicableToFormation(1300, m_index) / 100f;

            //负重
            int type = ArmyController.getInstance().getArmyTypeById(info.armyId);
            string temp = string.Format("130{0}", type);
            rate += EffectController.getInstance().getEffectValueByNumApplicableToGlobal(temp.intValue()) / 100.0f;

            // 运兵车负重
            rate += EffectController.getInstance().getEffectValueByNumOnlyApplicableToFormation(844, m_index) / 100f + EffectController.getInstance().getEffectValueByNumApplicableToGlobal(844) / 100f;

            // 最低的系数保底！
            if (rate < 0.05)
            {
                rate = 0.05f;
            }
            float ret = num * info.load * rate;


            // Global.CCLOG("FreeBuildFormationInfo.getLoadByArmyId id({0}) armynum({1}) === armyLoad({2}) ==== rate({3})", armyId, num, info.load, rate);
            return ret > 0 ? (int)ret : 0;
        }


