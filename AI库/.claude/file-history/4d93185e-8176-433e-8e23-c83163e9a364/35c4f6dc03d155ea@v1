        public string GetMarchTimeStrInfo(ref double totalTime, ref double leftTime, MarchActionType marchType = MarchActionType.None)
        {
            string timeStr = "";

            MarchInfo marchIt = WorldController.getInstance().getMarchInfoByFormationUuid(getUuid());
            QueueInfo queueIt = null;
            if (marchIt != null)
                queueIt = QueueController.getInstance().getQueueInfoByUuid(marchIt.Uuid);

            double now = Global.gGameTime.getWorldMsTime();
            totalTime = 0;
            leftTime = 0;

            bool recTimeStr = true;

            if (marchType == MarchActionType.None)
                marchType = GetMarchType();

            switch (marchType)
            {
                case MarchActionType.March:
                case MarchActionType.Return:
                case MarchActionType.InitiateRallyMarch:
                case MarchActionType.JoinRally2Home:
                case MarchActionType.JoinRallyMarch:
                    if (queueIt != null)
                    {
                        totalTime = queueIt.finishTime - queueIt.startTime;
                        leftTime = queueIt.finishTime - now;
                    }
                    else
                    {
                        recTimeStr = false;
                    }
                    break;
                case MarchActionType.Collect:
                    if (marchIt != null)
                    {
                        if (marchIt.TargetType == WorldCityType.ResourceTile ||
                            marchIt.TargetType == WorldCityType.tile_allianceAreaBuild)//普通资源
                        {
                            totalTime = marchIt.TroopMax / marchIt.DigSpeed * 1000;
                            leftTime = totalTime + marchIt.DigStartTime - now;
                        }
                        else if (marchIt.TargetType == WorldCityType.MINE_NEAR_RIVER ||
                            marchIt.TargetType == WorldCityType.MINE_OWN_PLAYER)//富矿
                        {
                            totalTime = marchIt.TroopMax / marchIt.DigSpeed * 1000;
                            leftTime = Global.MIN(marchIt.MineFlushTime, totalTime + marchIt.DigStartTime) - now;
                        }
                        else if (marchIt.TargetType == WorldCityType.Blood_Area_Big ||
                                 marchIt.TargetType == WorldCityType.Blood_Area_Small)///采集血岩矿
                        {
                            totalTime = marchIt.BloodEndTime - marchIt.BloodStartTime;
                            leftTime = totalTime + marchIt.BloodStartTime - now;
                            totalTime = Global.MAX(1, totalTime);
                            leftTime = Global.MAX(0, leftTime);
                            leftTime = Global.MIN(totalTime, leftTime);

                            timeStr = Global.CC_SECTOA((leftTime < 0 ? 0 : leftTime) / 1000);
                            var t = timeStr.Split(':');
                            if (t[2] != "00")
                            {
                                int intT = int.Parse(t[1]) + 1;
                                if (intT != 60)
                                    t[1] = intT.ToString("D2");
                                else
                                {
                                    t[1] = "00";
                                    intT = int.Parse(t[0]) + 1;
                                    t[0] = intT.ToString("D2");
                                }
                            }
                            t[2] = "00";
                            timeStr = Global._lang_1("2000001001", string.Join(":", t));
                            recTimeStr = false;
                        }
                    }
                    else
                    {
                        recTimeStr = false;
                    }
                    break;
                case MarchActionType.Defense:
                    if (marchIt != null)
                    {
                        if (marchIt.TargetType == WorldCityType.tile_one_level_city ||
                            marchIt.TargetType == WorldCityType.tile_one_level_city_range ||
                            marchIt.TargetType == WorldCityType.tile_two_level_city ||
                            marchIt.TargetType == WorldCityType.tile_two_level_city_range ||
                            marchIt.TargetType == WorldCityType.Throne ||
                            marchIt.TargetType == WorldCityType.ThroneRange)
                        {
                            var cityData = WorldCityController.getInstance().GetWorldCityData(marchIt.EndPointIndex);
                            if (cityData != null && cityData.status == CityStatus.OPEND)
                            {
                                if (cityData.endTime > 0)
                                {
                                    //todo：总共多少秒？
                                    //totalTime = 600000;
                                    //leftTime = cityData.endTime - now;
                                    totalTime = 100;
                                    leftTime = 0;
                                    timeStr = Global.CC_SECTOA(Mathf.Max((int)((cityData.endTime - now) / 1000), 0));
                                    recTimeStr = false;
                                }
                            }
                            else
                            {
                                totalTime = 100;
                                leftTime = 0;
                                ///timeStr = "00:00:00";
                                timeStr = "";
                                recTimeStr = false;
                            }
                        }
                        else
                        {//TERRITORY_BANNER
                            totalTime = marchIt.EndStamp - marchIt.StartStamp;
                            leftTime = totalTime - (now - marchIt.StartStamp);
                            if (leftTime < 0)
                            {
                                timeStr = "";
                                recTimeStr = false;
                            }
                        }
                    }
                    break;
                case MarchActionType.InitiateRally:
                case MarchActionType.JoinRallyWait:
                    if (queueIt != null && queueIt.type == (int)QueueType.TYPE_ARMY_MASS)
                    {
                        double otherFinishTime = double.MinValue;
                        /*var team = GetJoinMarchs(marchIt.teamUid);
                        foreach (var m in team)
                        {
                            var mqueue = QueueController.getInstance().getQueueInfoByUuid(m.uuid);
                            if (mqueue.finishTime> otherFinishTime)
                                otherFinishTime = mqueue.finishTime;
                        }*/

                        double finishTime = queueIt.finishTime > otherFinishTime ? queueIt.finishTime : otherFinishTime;

                        totalTime = finishTime - queueIt.startTime;
                        leftTime = finishTime - now;
                        if (marchIt.TeamMarchType == 1)
                        {
                            if (AZCommonUtils.checkAdvancedMassInUnionStage(leftTime))
                            {
                                leftTime -= GlobalData.shared().teamMarchStartTime * 1000;
                                totalTime -= GlobalData.shared().teamMarchStartTime * 1000;
                            }
                            else
                            {
                                totalTime = GlobalData.shared().teamMarchStartTime * 1000;
                            }
                        }
                    }
                    break;
                default:
                    recTimeStr = false;
                    break;
            }

            if (recTimeStr)
            {
                totalTime = Global.MAX(1, totalTime);
                leftTime = Global.MAX(0, leftTime);
                leftTime = Global.MIN(totalTime, leftTime);
                timeStr = Global.CC_SECTOA((leftTime < 0 ? 0 : leftTime) / 1000);
            }
            return timeStr;
        }

