        public int CalcSoldierTotalNew()
        {
            int calcTotal = 0;
            for (int i = 0; i < 3; ++i)
            {
                int basic = 0;
                int skillEff = 0;
                if (string.IsNullOrEmpty(m_heros[i].heroId))
                {
                    m_heros[i].maxMarch = 0;
                    continue;
                }

                int addSoldiers = (int)(EffectController.getInstance().getEffectValueByNumOnlyApplicableToFormation(56, getIndex()));
                //10011步10012騎兵10013弓兵
                int tbly_addSoldiers = (int)EffectController.getInstance().getEffectValueByNumApplicableToGlobal(10011 + i);
                LogCommon.Log($"tbly_addSoldiers = {tbly_addSoldiers} ; buffId = {10011 + i}");
                addSoldiers += tbly_addSoldiers;

                var data = DataAtlasManager.Instance.GetDataWithTypeById<NewHeroes>(m_heros[i].heroId);
                UavInfoData uavInfo = UavsController.getInstance().getUavInfoData(m_uavUid);
                if (data != null)
                {
                    LogCommon.Log($"m_heros[i].heroId = {m_heros[i].heroId} ; heroName : {Global._lang(data.full_name)}");
                    var myHero = FreeBuildHeroController.getInstance().getMyHeroInfoByHeroId(m_heros[i].heroId);
                    // 计算basic
                    string id = data.extra_skill[0];
                    if (!string.IsNullOrEmpty(id))
                    {
                        var d = DataAtlasManager.Instance.GetDataWithTypeById<More_hero_skills>(id);
                        basic = d.skill_para[myHero.getLevel() - 1];
                    }
                    // 计算eff
                    float eff_978 = 1;
                    for (int j = 0; j < myHero.getGrooveCnt(); j++)
                    {
                        FBHeroSkillGroove groove = myHero.getGrooveInfoByIndex(j + 1);
                        if (groove != null)
                        {
                            string xmlId = groove.getNativeHoldSkillXMLId();
                            var xmlInfo = FBHeroSkillXMLInfo.create(xmlId);
                            if (groove.getCurHoldSkillInfo() != null)
                            {
                                FBHeroSkillInfo skillInfo = groove.getCurHoldSkillInfo();
                                eff_978 += skillInfo.getEffectValueByNumLevelHeroLevelForShow(978, skillInfo.getLevel(), myHero.getLevel()) / 100.0f;
                            }
                            else
                            {
                                continue;
                            }
                        }
                    }
                    for (int j = 0; j < myHero.getGrooveCnt(); j++)
                    {
                        FBHeroSkillGroove groove = myHero.getGrooveInfoByIndex(j + 1);
                        if (groove != null)
                        {
                            string xmlId = groove.getNativeHoldSkillXMLId();
                            var xmlInfo = FBHeroSkillXMLInfo.create(xmlId);
                            if (xmlInfo.getFirstNum() == 56 && groove.getCurHoldSkillInfo() != null)///56是增加带兵容量
                            {
                                skillEff += (int)(xmlInfo.getEffectValueByNumLevelHeroLevelForShow(56, groove.getCurHoldSkillInfo().getLevel(), myHero.getLevel()) * eff_978);
                            }
                            else
                            {
                                continue;
                            }
                        }
                    }
                    skillEff += FreeBuildHeroController.getInstance().getStarSkillAddProp(m_heros[i].heroId)[0];
                    // 计算红警
                    m_heros[i].maxMarch = basic + addSoldiers + skillEff + CalcHeroSoldierCount(m_heros[i].heroId, myHero.getLevel() - 1);

                    if (UavsController.getInstance().BuildingExistByXml)
                    {
                        if (uavInfo != null)
                        {
                            m_heros[i].maxMarch += (int)uavInfo.getAttrAll(UavUavAttrType.force_cap);
                            //LogCommon.LogError($"小队带兵：{m_heros[i].maxMarch}");
                            //LogCommon.LogError($"无人机带兵：{ (int)uavInfo.getAttrAll(UavUavAttrType.force_cap)}");

                        }
                    }

                    // m_heros[i].count = Math.Min(m_heros[i].count, m_heros[i].maxMarch);
                    calcTotal += m_heros[i].maxMarch;
                    //LogCommon.LogError("HeroMaxMarch index : {0} - {1}", i, m_heros[i].maxMarch);
                }
                else
                {
                    m_heros[i].maxMarch = basic + addSoldiers;
                    calcTotal += m_heros[i].maxMarch;
                }
            }
            //LogCommon.LogError("CalcSoldierTotalNew index : {0} - {1}",m_sortIndex,  calcTotal);
            return calcTotal;
        }

