        public bool initFromDict(CCDictionary dict)
        {
            if (dict == null)
            {
                return false;
            }
            parseHeroSoldierAndUav(dict);
            if (dict.ContainsKey("maxNum"))
            {
                m_maxNum = (int)dict.valueForKey("maxNum").longValue();
                LogCommon.LogError($"SuperFormationInfo initFromDict maxNum: {m_maxNum}");
            }

            CCDictionary dic = (CCDictionary)(dict.objectForKey("march"));
            if (dic != null)
            {
                if (dic.objectForKey("uuid") != null)
                {
                    CollectInfo resInfo = CollectInfo.create();

                    string key = dic.valueForKey("uuid");
                    resInfo.troopMax = dic.valueForKey("q").intValue();
                    resInfo.digSpeed = dic.valueForKey("spd").floatValue();
                    resInfo.digStartTime = dic.valueForKey("sdt").doubleValue();
                    resInfo.digStartNum = dic.valueForKey("collected").intValue();
                    resInfo.changeCollectSpdTime = dic.valueForKey("changeCollectSpdTime").doubleValue();
                    resInfo.resType = dic.valueForKey("t").intValue();
                    m_ResCollect[key] = resInfo;
                }
            }

            CCDictionary pfortressDic = (CCDictionary)(dict.objectForKey("world_building"));
            if (pfortressDic != null)
            {
                pFortress.pointId = pfortressDic.valueForKey("pointId").intValue();
                pFortress.index = pfortressDic.valueForKey("index").intValue();
            }
            refreshFromData();

            return true;
        }

