@echo off
chcp 65001 > nul
echo.
echo 🀄 桐城自摸麻将服务器 (自动重启模式)
echo ========================================
echo.

cd /d "%~dp0"

REM 检查node_modules是否存在
if not exist "node_modules" (
    echo 首次运行，正在安装依赖...
    call npm install
    echo.
)

echo 启动服务器 (自动重启模式)...
echo 提示: 修改代码后服务器会自动重启
echo.
call npm run dev

pause
