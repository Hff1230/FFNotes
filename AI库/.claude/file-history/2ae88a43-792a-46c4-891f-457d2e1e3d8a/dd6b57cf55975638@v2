@echo off
chcp 65001 > nul
title Guandan Server - Auto Restart

cd /d "%~dp0"

if not exist "node_modules" (
    echo Installing dependencies...
    call npm install
    echo.
)

if not exist "node_modules\nodemon" (
    echo Installing nodemon...
    call npm install nodemon --save-dev
    echo.
)

echo Starting server (auto-restart mode)...
echo Tip: Server will auto-restart when code changes
echo.

call npm run dev

pause
