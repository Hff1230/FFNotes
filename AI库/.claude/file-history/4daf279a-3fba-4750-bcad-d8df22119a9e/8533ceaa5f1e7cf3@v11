        }

        /* ==================== 牌墙样式 ==================== */
        .wall-container {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 700px;
            height: 600px;
            pointer-events: none;
            z-index: 0;
            display: none; /* 默认隐藏 */
        }

        .wall-section {
            position: absolute;
            display: flex;
        }

        /* 上方牌墙（北-3号位）- 水平排列，居中 */
        .wall-top {
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            flex-direction: row;
            gap: 1px;
        }

        /* 下方牌墙（南-1号位）- 水平排列，居中 */
        .wall-bottom {
            bottom: 10px;
            left: 50%;
            transform: translateX(-50%);
            flex-direction: row;
            gap: 1px;
        }

        /* 左方牌墙（西-4号位）- 垂直排列，居中 */
        .wall-left {
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            flex-direction: column;
            gap: 1px;
        }

        /* 右方牌墙（东-2号位）- 垂直排列，居中 */
        .wall-right {
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            flex-direction: column;
            gap: 1px;
        }

        /* 牌墩容器 - 每墩两张牌叠放 */
        .wall-pile {
            position: relative;
        }

        /* 上下牌墩尺寸 - 包含侧边厚度 */
        .wall-top .wall-pile,
        .wall-bottom .wall-pile {
            width: 28px;
            height: 50px;
        }

        /* 左右牌墩尺寸 - 包含侧边厚度 */
        .wall-left .wall-pile,
        .wall-right .wall-pile {
            width: 50px;
            height: 28px;
        }

        /* 牌墩中的单张牌 - 带侧边的3D效果 */
        .wall-tile {
            position: absolute;
            border-radius: 3px 3px 2px 2px;
        }

        /* ============ 3D牌面效果 ============ */
        /* 上面的牌（顶层）- 带侧边 */
        .wall-tile.top-tile {
            z-index: 2;
        }

        /* 上面的牌的侧边（使用伪元素） */
        .wall-tile.top-tile::after {
            content: '';
            position: absolute;
            background: #1B5E20;
            border-radius: 0 0 2px 2px;
        }

        /* 下面的牌（底层）- 带侧边 */
        .wall-tile.bottom-tile {
            z-index: 1;
        }

        /* 下面的牌的侧边 */
        .wall-tile.bottom-tile::after {
            content: '';
            position: absolute;
            background: #0D3D0D;
            border-radius: 0 0 2px 2px;
        }

        /* ============ 上下牌墙：上下堆叠，侧边朝下 ============ */
        .wall-top .wall-tile,
        .wall-bottom .wall-tile {
            width: 28px;
            height: 40px;
        }

        /* 上面的牌（顶层）- 更亮 */
        .wall-top .wall-tile.top-tile,
        .wall-bottom .wall-tile.top-tile {
            top: 0;
            left: 0;
            background: linear-gradient(180deg, #b8f0b8 0%, #81C784 40%, #4CAF50 100%);
            border: 1px solid #2E7D32;
            box-shadow: 2px 2px 4px rgba(0,0,0,0.4);
        }

        /* 上面的牌的侧边 */
        .wall-top .wall-tile.top-tile::after,
        .wall-bottom .wall-tile.top-tile::after {
            left: 1px;
            bottom: -6px;
            width: 26px;
            height: 6px;
            background: linear-gradient(180deg, #2E7D32, #1B5E20);
        }

        /* 下面的牌（底层）- 更暗 */
        .wall-top .wall-tile.bottom-tile {
            top: 14px;
            left: 3px;
            background: linear-gradient(180deg, #4a9a4a 0%, #2E7D32 50%, #1B5E20 100%);
            border: 1px solid #0D3D0D;
            box-shadow: 1px 1px 2px rgba(0,0,0,0.3);
        }
        .wall-bottom .wall-tile.bottom-tile {
            top: 14px;
            left: 3px;
            background: linear-gradient(180deg, #4a9a4a 0%, #2E7D32 50%, #1B5E20 100%);
            border: 1px solid #0D3D0D;
            box-shadow: 1px 1px 2px rgba(0,0,0,0.3);
        }

        /* 下面的牌的侧边 */
        .wall-top .wall-tile.bottom-tile::after,
        .wall-bottom .wall-tile.bottom-tile::after {
            left: 1px;
            bottom: -5px;
            width: 24px;
            height: 5px;
            background: linear-gradient(180deg, #1B5E20, #0D3D0D);
        }

        /* ============ 左侧牌墙：左右堆叠，侧边朝右 ============ */
        .wall-left .wall-tile {
            width: 40px;
            height: 28px;
        }

        /* 上面的牌（顶层）- 更亮 */
        .wall-left .wall-tile.top-tile {
            left: 0;
            top: 0;
            background: linear-gradient(90deg, #b8f0b8 0%, #81C784 40%, #4CAF50 100%);
            border: 1px solid #2E7D32;
            box-shadow: 2px 2px 4px rgba(0,0,0,0.4);
        }

        /* 上面的牌的侧边（朝右） */
        .wall-left .wall-tile.top-tile::after {
            right: -6px;
            top: 1px;
            width: 6px;
            height: 26px;
            background: linear-gradient(90deg, #2E7D32, #1B5E20);
            border-radius: 0 2px 2px 0;
        }

        /* 下面的牌（底层）- 更暗 */
        .wall-left .wall-tile.bottom-tile {
            left: 14px;
            top: 3px;
            background: linear-gradient(90deg, #4a9a4a 0%, #2E7D32 50%, #1B5E20 100%);
            border: 1px solid #0D3D0D;
            box-shadow: 1px 1px 2px rgba(0,0,0,0.3);
        }

        /* 下面的牌的侧边（朝右） */
        .wall-left .wall-tile.bottom-tile::after {
            right: -5px;
            top: 1px;
            width: 5px;
            height: 24px;
            background: linear-gradient(90deg, #1B5E20, #0D3D0D);
            border-radius: 0 2px 2px 0;
        }

        /* ============ 右侧牌墙：左右堆叠，侧边朝左 ============ */
        .wall-right .wall-tile {
            width: 40px;
            height: 28px;
        }

        /* 上面的牌（顶层）- 更亮 */
        .wall-right .wall-tile.top-tile {
            left: 0;
            top: 0;
            background: linear-gradient(270deg, #b8f0b8 0%, #81C784 40%, #4CAF50 100%);
            border: 1px solid #2E7D32;
            box-shadow: 2px 2px 4px rgba(0,0,0,0.4);
