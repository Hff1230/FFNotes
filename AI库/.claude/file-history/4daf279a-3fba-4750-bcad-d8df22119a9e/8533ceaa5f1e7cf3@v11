        // ==================== 牌墙渲染 ====================
        // 牌墙状态：每方位17墩，每墩2张
        let wallState = {
            1: 17, // 东（1号位）
            2: 17, // 南（2号位）- 实际是右侧
            3: 17, // 西（3号位）- 上方
            4: 17  // 北（4号位）- 左侧
