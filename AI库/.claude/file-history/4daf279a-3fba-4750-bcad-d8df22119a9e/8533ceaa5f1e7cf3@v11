        /* 万能牌样式 - 癞子 */
        .card.wild {
            background: linear-gradient(180deg, #fff8e1 0%, #ffecb3 50%, #ffe082 100%);
            border: 2px solid #ffa000;
            box-shadow:
                1px 0 0 #ff8f00,
                0 2px 0 #f57c00,
                0 3px 0 #ef6c00,
                0 4px 0 #e65100,
                0 5px 3px rgba(255,152,0,0.4),
                0 0 10px rgba(255,160,0,0.5);
        }

        /* 癞子标记 */
        .card.wild::before {
            content: '癞';
            position: absolute;
            top: -2px;
            right: -2px;
            width: 13px;
            height: 13px;
            background: linear-gradient(135deg, #ff5722 0%, #e64a19 100%);
            color: white;
            font-size: 8px;
            font-weight: bold;
